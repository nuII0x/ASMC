{
  "name": "mycpu-asm-language",
  "displayName": "MyCPU Assembly",
  "description": "Syntax highlighting para a ISA da minha CPU de 8 bits",
  "version": "0.0.1",
  "publisher": "willian",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
