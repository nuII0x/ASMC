{
  "name": "Assembly compiler",
  "displayName": "ASMC Assembly Compiler",
  "description": "Syntax highlighting support for the ASCM assembly language",
  "version": "0.0.1",
  "publisher": "Null0x",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "asmc",
        "aliases": [
          "ASMC",
          "asmc"
        ],
        "extensions": [
          ".asm",
          ".asmc"
        ]
      }
    ],
    "grammars": [
      {
        "language": "asmc",
        "scopeName": "source.asmc",
        "path": "./asmc.tmLanguage.json"
      }
    ]
  }
}